# ============================================================
# Recruweb Salesportal - frontend environment
# Copy this file to .env.local  (cp .env.example .env.local)
# ============================================================

# --- Auth (REQUIRED) ---
# MUST be identical to JWT_SECRET in backend/.env
JWT_SECRET=recruweb-demo-jwt-secret-change-me-in-production-0123456789

# --- Super admin lockdown (REQUIRED, server-only) ---
# Must be identical to ADMIN_EMAIL in backend/.env
ADMIN_EMAIL=test.admin@recruweb-demo.com

# ============================================================
# Everything below is OPTIONAL.
# ============================================================

# Leave NEXT_PUBLIC_API_URL unset: the app calls same-origin /backend/*
# which next.config.mjs rewrites to the Express backend on port 5000.
# NEXT_PUBLIC_API_URL=

# Web push (optional - must match backend VAPID_PUBLIC_KEY)
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# UPI collection shown to customers (optional)
# NEXT_PUBLIC_UPI_VPA=
# NEXT_PUBLIC_UPI_PAYEE_NAME=
