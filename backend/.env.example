# ============================================================
# Recruweb Salesportal - backend environment
# Copy this file to .env  (cp .env.example .env)
# The defaults below work out of the box with backend/db/mysql/00_setup.sql
# ============================================================

# --- API server (REQUIRED) ---
PORT=5000
FRONTEND_ORIGIN=http://localhost:3000

# --- MySQL (REQUIRED - matches 00_setup.sql defaults) ---
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=salesportal_app
MYSQL_PASSWORD=Salesportal@App2026
MYSQL_DATABASE=salesportal

# --- Auth (REQUIRED) ---
# MUST be identical to JWT_SECRET in frontend/.env.local
# For production generate your own:  openssl rand -base64 48
JWT_SECRET=recruweb-demo-jwt-secret-change-me-in-production-0123456789
JWT_EXPIRES_IN=7d

# --- Super admin lockdown (REQUIRED) ---
# Only this exact account is treated as the platform admin.
# Must be identical to ADMIN_EMAIL in frontend/.env.local
ADMIN_EMAIL=test.admin@recruweb-demo.com

# ============================================================
# Everything below is OPTIONAL - the app runs fine without it.
# Features degrade gracefully when unset.
# ============================================================

# --- AI Assistant (optional - Google Gemini, free key: https://aistudio.google.com) ---
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash

# --- Email via SMTP (optional - e.g. Gmail App Password: https://myaccount.google.com/apppasswords) ---
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="Recruweb <no-reply@example.com>"

# --- Web push notifications (optional - generate with: npx web-push generate-vapid-keys) ---
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@example.com
